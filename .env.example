# --------------------------------------------------------------------------
# Copy to `.env` (production, docker compose) or `.env.local` (npm run dev).
# Generate secrets with:  openssl rand -hex 32
# --------------------------------------------------------------------------

# Public URL of the site (no trailing slash)
APP_URL=https://erhankarahan.com

# Auth & privacy
BETTER_AUTH_SECRET=change-me-to-a-64-char-random-hex-string-000000000000000000000
IP_HASH_SECRET=change-me-to-a-random-string

# --- Database -------------------------------------------------------------
# Production compose builds DATABASE_URL from these three values.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
# Local development only:
DATABASE_URL=postgres://portfolio:portfolio@127.0.0.1:5432/portfolio

# --- Object storage (S3 compatible) ----------------------------------------
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey123
S3_BUCKET=portfolio-media
S3_FORCE_PATH_STYLE=true

# --- Upload security --------------------------------------------------------
# ClamAV daemon (set automatically by docker compose). Leave empty to disable locally.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Reject uploads when the virus scanner is unavailable (recommended in production).
UPLOAD_REQUIRE_SCAN=true
UPLOAD_MAX_IMAGE_MB=25
UPLOAD_MAX_VIDEO_MB=2048
UPLOAD_MAX_DOCUMENT_MB=25

# --- Reverse proxy (production) -------------------------------------------
SITE_DOMAIN=erhankarahan.com
ACME_EMAIL=you@example.com
